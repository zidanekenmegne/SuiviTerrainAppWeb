# Base de données production (fourni par Render)
DATABASE_URL=postgresql://user:password@host:5432/database

# Secrets (générer avec : python -c "import secrets; print(secrets.token_urlsafe(64))")
SECRET_KEY=remplacer-par-un-secret-unique
JWT_SECRET_KEY=remplacer-par-un-secret-unique

# URL du frontend en production (Vercel)
FRONTEND_URL=https://suivi-terrain.vercel.app

# Environnement
FLASK_ENV=production